# Option A — full URI (password must be URL-encoded: @ → %40, etc.)
# If DNS to SRV times out on your network, use Atlas “Standard connection string” (mongodb://host1:27017,host2:27017,...)
# instead of mongodb+srv://…
MONGODB_URI=mongodb://localhost:27017

# Option B — Atlas without encoding the password yourself (recommended if password has @ or other symbols)
# MONGODB_ATLAS_USER=myuser
# MONGODB_ATLAS_PASSWORD=myRawPasswordWith@symbols
# MONGODB_ATLAS_HOST=cluster0.xxxxx.mongodb.net

MONGODB_DB_NAME=emotion_chatbot
FRONTEND_ORIGIN=http://localhost:5173
MODEL_NAME=j-hartmann/emotion-english-distilroberta-base
# Required for emotion detection. Prefer a fine-grained token with “Inference Providers” permission:
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_API_TOKEN=YOUR_HF_API_TOKEN_HERE
# Optional: forces HF’s own inference route (default). Set empty only if you know you need to.
# HF_INFERENCE_PROVIDER=hf-inference
CONTEXT_WINDOW_SIZE=10
SECRET_KEY=your-secret-key-here-change-in-production

# Set true temporarily to see database_error on GET /health when MongoDB fails.
# DATABASE_DEBUG=true
